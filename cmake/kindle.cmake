set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES KINDLE_TOOLCHAIN_ROOT)

set(KINDLE_TOOLCHAIN_ROOT
    ""
    CACHE PATH "Unpacked KOReader kindlepw2 toolchain")
if(NOT IS_DIRECTORY "${KINDLE_TOOLCHAIN_ROOT}")
    message(FATAL_ERROR "Set KINDLE_TOOLCHAIN_ROOT to the unpacked kindlepw2 toolchain")
endif()
set(_kindle_triple arm-kindlepw2-linux-gnueabi)
set(CMAKE_SYSROOT "${KINDLE_TOOLCHAIN_ROOT}/${_kindle_triple}/sysroot")

find_program(CMAKE_C_COMPILER NAMES clang REQUIRED)
find_program(CMAKE_CXX_COMPILER NAMES clang++ REQUIRED)
set(CMAKE_C_COMPILER_TARGET "${_kindle_triple}")
set(CMAKE_CXX_COMPILER_TARGET "${_kindle_triple}")
set(CMAKE_C_COMPILER_EXTERNAL_TOOLCHAIN "${KINDLE_TOOLCHAIN_ROOT}")
set(CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN "${KINDLE_TOOLCHAIN_ROOT}")
set(_kindle_flags "--no-default-config -march=armv7-a -mcpu=cortex-a9 -mfpu=neon -mfloat-abi=softfp -mthumb")
set(CMAKE_C_FLAGS_INIT "${_kindle_flags}")
set(CMAKE_CXX_FLAGS_INIT "${_kindle_flags}")
set(_kindle_linker "--ld-path=${KINDLE_TOOLCHAIN_ROOT}/bin/${_kindle_triple}-ld.bfd")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_kindle_linker}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_kindle_linker} -static-libstdc++ -static-libgcc")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
